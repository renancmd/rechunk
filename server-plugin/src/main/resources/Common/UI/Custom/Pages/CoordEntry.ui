$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 46);
  Padding: (Horizontal: 4, Vertical: 3);

  Group #BackgroundChunkEntry {
    FlexWeight: 1;
    LayoutMode: Top;
    Background: #141c26(0.8);
    Padding: (Left: 10, Top: 3);

    Label #ChunkCoordinates {
      Text: "X, Z";
      Anchor: (Height: 19);
      Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
    }

    Label #BlockCoordinates {
      Text: "X, Z";
      Anchor: (Height: 15);
      Style: (FontSize: 11, TextColor: #96a9be, VerticalAlignment: Center);
    }
  }

  Group { Anchor: (Width: 6); }

  $C.@SmallSecondaryTextButton #RemoveButton {
    @Anchor = (Top: 4);
    @Text = "Remove";
  }
}
