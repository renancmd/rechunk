$C = "../Common.ui";

@HintStyle = LabelStyle(FontSize: 13, TextColor: #878e9c, Wrap: true);
@PanelBackground = PatchStyle(TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1000, Height: 720);

  #Title {
    $C.@Title {
      @Text = "ReChunk";
    }
  }

  #Content {
    LayoutMode: Left;

    Group #InputPanel {
      Anchor: (Width: 420);
      LayoutMode: Top;

      Group {
        LayoutMode: Top;
        Background: @PanelBackground;
        Padding: (Full: 12);

        $C.@Subtitle {
          @Text = "Add chunks";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 66);

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #LabelX {
              Text: "Block X";
              Anchor: (Height: 24);
              Style: $C.@DefaultLabelStyle;
            }

            $C.@TextField #XInput {
              Anchor: (Height: 40);
              PlaceholderText: "Ex.: 192";
            }
          }

          Group { Anchor: (Width: 10); }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #LabelZ {
              Text: "Block Z";
              Anchor: (Height: 24);
              Style: $C.@DefaultLabelStyle;
            }

            $C.@TextField #ZInput {
              Anchor: (Height: 40);
              PlaceholderText: "Ex.: 141";
            }
          }
        }

        $C.@SmallSecondaryTextButton #UsePositionButton {
          @Anchor = (Top: 8);
          @Text = "Use my position";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 10, Height: 35);

          Label #BufferLabel {
            Text: "Buffer (chunks around)";
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          }

          $C.@DropdownBox #BufferInput {
            Anchor: (Width: 110, Height: $C.@DropdownBoxHeight);
          }
        }

        $C.@SecondaryTextButton #SaveButton {
          @Anchor = (Top: 12);
          Text: "Add to selection";
        }
      }

      Group { Anchor: (Height: 12); }

      Group {
        LayoutMode: Top;
        Background: @PanelBackground;
        Padding: (Full: 12);

        $C.@Subtitle {
          @Text = "Mode";
        }

        $C.@DropdownBox #ModeInput {
          Anchor: (Height: $C.@DropdownBoxHeight);
        }

        Label {
          Anchor: (Top: 10);
          Style: @HintStyle;
          Text: "Protect: keeps the selected chunks and regenerates the area around them.";
        }

        Label {
          Anchor: (Top: 6);
          Style: @HintStyle;
          Text: "Reset: regenerates only the selected chunks.";
        }
      }

      Group { Anchor: (Height: 12); }

      Group {
        LayoutMode: Top;
        Background: @PanelBackground;
        Padding: (Full: 12);

        $C.@Subtitle {
          @Text = "Presets";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 35);

          $C.@DropdownBox #PresetInput {
            Anchor: (Width: 270, Height: $C.@DropdownBoxHeight);
          }

          Group { Anchor: (Width: 8); }

          $C.@SmallSecondaryTextButton #AddPresetButton {
            @Text = "Add preset";
          }
        }

        Label {
          Anchor: (Top: 8);
          Style: @HintStyle;
          Text: "Adds a saved list of chunks to the selection. Create presets with /rechunk presets.";
        }
      }

      Group { FlexWeight: 1; }

      Label #InfoText {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #8fbf8f, FontSize: 14);
        Visible: false;
      }

      Label #StatusText {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e06c6c, FontSize: 14);
        Visible: false;
      }

      Group {
        LayoutMode: Left;

        $C.@TextButton #StartButton {
          @Anchor = (Right: 4);
          Text: "Start";
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #CloseButton {
          @Anchor = (Left: 4);
          Text: "Close";
          FlexWeight: 1;
        }
      }
    }

    Group { Anchor: (Width: 16); }

    Group #ListPanel {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 35, Bottom: 8);

        Label #SelectionCount {
          Text: "Selected chunks (0)";
          FlexWeight: 1;
          Style: (...$C.@SubtitleStyle, VerticalAlignment: Center);
        }

        $C.@SmallSecondaryTextButton #ClearButton {
          @Text = "Clear";
        }
      }

      Group #CoordinatesList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: @PanelBackground;
        Padding: (Full: 6);
      }
    }
  }
}
