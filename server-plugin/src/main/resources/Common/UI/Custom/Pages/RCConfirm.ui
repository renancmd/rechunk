$C = "../Common.ui";

@HintStyle = LabelStyle(FontSize: 13, TextColor: #878e9c, Wrap: true);

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 640, Height: 460);

  #Title {
    $C.@Title {
      @Text = "Confirm regeneration";
    }
  }

  #Content {
    LayoutMode: Top;

    Label #ConfirmSummary {
      Anchor: (Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #ffffff);
    }

    Label #ConfirmTeleporters {
      Anchor: (Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e8a93b);
      Visible: false;
    }

    Label {
      Anchor: (Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, Wrap: true);
      Text: "This cannot be undone. Make sure you have a backup of your world before continuing.";
    }

    Label {
      Style: @HintStyle;
      Text: "Not sure how this works? Read the manual first.";
    }

    Group { FlexWeight: 1; }

    Label #StatusText {
      Anchor: (Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e06c6c, FontSize: 14);
      Visible: false;
    }

    Group {
      LayoutMode: Left;

      $C.@CancelTextButton #ConfirmButton {
        @Anchor = (Right: 4);
        Text: "Regenerate";
        FlexWeight: 1;
      }

      $C.@SecondaryTextButton #BackButton {
        @Anchor = (Horizontal: 4);
        Text: "Back";
        FlexWeight: 1;
      }

      $C.@SecondaryTextButton #ManualButton {
        @Anchor = (Left: 4);
        Text: "Manual";
        FlexWeight: 1;
      }
    }
  }
}
