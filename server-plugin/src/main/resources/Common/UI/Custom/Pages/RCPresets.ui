$C = "../Common.ui";

@HintStyle = LabelStyle(FontSize: 13, TextColor: #878e9c, Wrap: true);
@PanelBackground = PatchStyle(TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1000, Height: 720);

  #Title {
    $C.@Title {
      @Text = "ReChunk presets";
    }
  }

  #Content {
    LayoutMode: Left;

    Group #FormPanel {
      Anchor: (Width: 420);
      LayoutMode: Top;

      Group {
        LayoutMode: Top;
        Background: @PanelBackground;
        Padding: (Full: 12);

        $C.@Subtitle {
          @Text = "New preset";
        }

        Label #SelectionInfo {
          Anchor: (Bottom: 8);
          Style: (...$C.@DefaultLabelStyle, Wrap: true);
          Text: "Your current selection has 0 chunk(s).";
        }

        Label {
          Text: "Name";
          Anchor: (Height: 24);
          Style: $C.@DefaultLabelStyle;
        }

        $C.@TextField #NameInput {
          Anchor: (Height: 40);
          PlaceholderText: "Ex.: Main base";
          MaxLength: 24;
        }

        $C.@SecondaryTextButton #SavePresetButton {
          @Anchor = (Top: 12);
          Text: "Save selection as preset";
        }

        Label {
          Anchor: (Top: 8);
          Style: @HintStyle;
          Text: "A preset is a copy of your current selection. Build the selection in /rechunk first.";
        }
      }

      Group { Anchor: (Height: 12); }

      Group {
        LayoutMode: Top;
        Background: @PanelBackground;
        Padding: (Full: 12);

        $C.@Subtitle {
          @Text = "Rename or delete";
        }

        Label {
          Text: "Preset";
          Anchor: (Height: 24);
          Style: $C.@DefaultLabelStyle;
        }

        $C.@DropdownBox #PresetInput {
          Anchor: (Height: $C.@DropdownBoxHeight);
        }

        Label {
          Text: "New name";
          Anchor: (Top: 8, Height: 24);
          Style: $C.@DefaultLabelStyle;
        }

        $C.@TextField #RenameInput {
          Anchor: (Height: 40);
          PlaceholderText: "Ex.: Village";
          MaxLength: 24;
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 12);

          $C.@SecondaryTextButton #RenameButton {
            @Anchor = (Right: 4);
            Text: "Rename";
            FlexWeight: 1;
          }

          $C.@CancelTextButton #DeleteButton {
            @Anchor = (Left: 4);
            Text: "Delete";
            FlexWeight: 1;
          }
        }
      }

      Group { FlexWeight: 1; }

      Label #InfoText {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #8fbf8f, FontSize: 14);
        Visible: false;
      }

      Label #StatusText {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e06c6c, FontSize: 14);
        Visible: false;
      }

      Group {
        LayoutMode: Left;

        $C.@TextButton #OpenMainButton {
          @Anchor = (Right: 4);
          Text: "Open ReChunk";
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #CloseButton {
          @Anchor = (Left: 4);
          Text: "Close";
          FlexWeight: 1;
        }
      }
    }

    Group { Anchor: (Width: 16); }

    Group #ListPanel {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #PresetCount {
        Text: "Saved presets (0/20)";
        Anchor: (Height: 35, Bottom: 8);
        Style: (...$C.@SubtitleStyle, VerticalAlignment: Center);
      }

      Group #PresetList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: @PanelBackground;
        Padding: (Full: 6);
      }
    }
  }
}
